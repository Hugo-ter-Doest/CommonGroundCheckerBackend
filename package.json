{
  "name": "common-ground-repo-analysis-register",
  "version": "1.0.0",
  "description": "Online register for Common Ground component analysis",
  "private": true,
  "license": "EUPL-1.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern src/generated/** --ignore-pattern .next/** --ignore-pattern coverage/** --ignore-pattern badges/**",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:badge": "node scripts/update-coverage-badge.mjs",
    "security:badge": "node scripts/update-security-badge.mjs",
    "test:watch": "vitest",
    "security": "npm audit --audit-level=high",
    "security:secrets": "gitleaks git . --config .gitleaks.toml --redact",
    "db:start": "docker compose up -d db",
    "db:stop": "docker compose down",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "js-yaml": "^4.1.0",
    "next": "^16.2.3",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitest/coverage-v8": "^4.1.4",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.3",
    "postcss": "^8.4.38",
    "prisma": "^7.8.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vitest": "^4.1.4"
  }
}
